# 复制为 .env 后填写真实值。本文件只放占位符，禁止写入任何可用凭证。

# 数据库：本地开发用 Docker/本机 PostgreSQL
DATABASE_URI=postgresql://daybreak:daybreak@localhost:5432/daybreak

# 会话签名密钥：必须为长随机串，缺失时应用会直接拒绝启动
# 生成方式：openssl rand -base64 48
PAYLOAD_SECRET=

# 站点公网地址，用于 canonical 链接与 OG 分享图
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 本地开发可设为 true，让 Payload 直接按模型改表；生产必须保持关闭，
# 用 npm run migrate:create 生成迁移文件后由 npm run migrate 应用
PAYLOAD_DB_PUSH=false

# 仅用 Docker Compose 起数据库时需要；线上请换成强密码并只走内网
POSTGRES_PASSWORD=daybreak

# 可选：S3 兼容对象存储。设置 S3_BUCKET 即启用，否则媒体写入本地 media 目录
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
